{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "PlanIT React library (consumed as source by a bundler)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "noEmit": true
  }
}
