{
  "name": "@planit/ui",
  "version": "0.0.0",
  "private": true,
  "description": "PlanIT design tokens and accessible base UI components. Consumed as TypeScript source by the web app's bundler.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./lib/cn": "./src/lib/cn.ts",
    "./components/*": "./src/components/*.tsx",
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@planit/config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
