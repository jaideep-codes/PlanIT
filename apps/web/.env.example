# Copy to apps/web/.env.local for local development.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle. Never give a
# secret that prefix: PlanIT-managed AI keys, OAuth secrets, and database credentials belong
# to the API only.

# Server-side origin of the PlanIT API used by the /api/* rewrite (read at build time too).
API_INTERNAL_URL=http://127.0.0.1:4000
