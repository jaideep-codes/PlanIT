# Copy to apps/api/.env for local development. Values match docker-compose.yml defaults.
# Real secrets (production DB credentials, provider keys, OAuth secrets) must come from the
# deployment platform's secret manager — never from a committed file.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://planit:planit_dev_password@127.0.0.1:5432/planit
REDIS_URL=redis://:planit_dev_redis@127.0.0.1:6379/0

# Comma-separated browser origins allowed by CORS.
WEB_ORIGINS=http://localhost:3000

# Express "trust proxy" setting (false | true | hop count | subnet list). Keep `false` unless
# every hop in front of the API overwrites/appends X-Forwarded-For; otherwise clients can spoof
# their IP and evade rate limits. See docs/security.md ("Client IP and rate limiting").
TRUST_PROXY=false

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
