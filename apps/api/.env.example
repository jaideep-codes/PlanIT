# Copy to apps/api/.env for local development. Values match docker-compose.yml defaults.
# Real secrets (production DB credentials, provider keys, OAuth secrets) must come from the
# deployment platform's secret manager — never from a committed file.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://planit:planit_dev_password@127.0.0.1:5432/planit
REDIS_URL=redis://:planit_dev_redis@127.0.0.1:6379/0

# Comma-separated browser origins allowed by CORS.
WEB_ORIGINS=http://localhost:3000

# Express "trust proxy" setting (false | true | hop count | subnet list). Keep `false` unless
# every hop in front of the API overwrites/appends X-Forwarded-For; otherwise clients can spoof
# their IP and evade rate limits. See docs/security.md ("Client IP and rate limiting").
TRUST_PROXY=false

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# 32-byte development keys, base64-encoded. Generate new values for any shared environment.
# JWT_SIGNING_KEY signs access tokens. OTP_PEPPER hashes OTP codes and client IP addresses.
# OTP_JOB_ENCRYPTION_KEY seals queued email bodies so Redis never holds a plaintext OTP.
JWT_SIGNING_KEY=bG9jYWwtZGV2LWp3dC1zaWduaW5nLWtleS0zMmJ5dGU=
OTP_PEPPER=bG9jYWwtZGV2LW90cC1wZXBwZXItdmFsdWUtMzJieXQ=
OTP_JOB_ENCRYPTION_KEY=bG9jYWwtZGV2LW90cC1qb2Ita2V5LTMyLWJ5dGVzISE=

# Mailpit (docker compose) receives mail on 1025. The inbox UI is http://127.0.0.1:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=PlanIT <noreply@planit.local>
SMTP_USER=
SMTP_PASSWORD=
