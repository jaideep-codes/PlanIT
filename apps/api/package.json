{
  "name": "@planit/api",
  "version": "0.0.0",
  "private": true,
  "description": "PlanIT API — NestJS modular monolith.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"nest start --watch --preserveWatchOutput\" \"node scripts/dev-worker.mjs\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@planit/shared": "workspace:*",
    "@planit/types": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "bullmq": "5.61.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.1",
    "nodemailer": "7.0.9",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@planit/config": "workspace:*",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/nodemailer": "7.0.4",
    "@types/supertest": "7.2.1",
    "concurrently": "9.2.1",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
